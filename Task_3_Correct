def _generate_intra_hour_arrival_minutes(N, lsp_proportion=0.8, lsp_mean=15, lsp_std=5):
    """
    Generates arrival minutes within an hour (Task 2 logic).
    LSPs tend to arrive earlier, Customers are uniform.
    """
    if N <= 0: return []
    n_lsp = int(round(N * lsp_proportion))
    n_cust = N - n_lsp
    
    # LSP arrivals (Normal distribution, centered early, clipped 0-60)
    lsp_times = np.clip(np.random.normal(loc=lsp_mean, scale=lsp_std, size=n_lsp), 0, 59.99)
    # Customer arrivals (Uniform distribution)
    cust_times = np.random.uniform(0, 59.99, n_cust)
    
    all_times = np.concatenate((lsp_times, cust_times))
    all_times.sort()
    return list(all_times)


def _simulate_annual_demand_path(mode='random') -> list[int]:
    """Simulates a 5-year demand path through the scenario tree (Figure 1)."""
    annual_demands = []
    current_node = 'start'
    for _ in range(5):
        next_states = SCENARIO_TREE.get(current_node)
        if not next_states: break
            
        nodes, probabilities = zip(*next_states)
        
        if mode == 'highest':
            chosen_node = max(nodes, key=lambda node: SCENARIO_DEMANDS.get(node, 0))
        else: # Default to 'random'
            chosen_node = np.random.choice(nodes, p=probabilities)
            
        annual_demands.append(SCENARIO_DEMANDS.get(chosen_node, 0))
        current_node = chosen_node
        
    return annual_demands


def _calculate_expected_annual_demands(tree: dict, demands: dict) -> list[int]:
    """Calculates the weighted average (expected) demand for each of the 5 years."""
    absolute_probs = {}
    year_nodes = {y: [] for y in range(1, 6)}
    
    # Group nodes by year
    for node_name in demands.keys():
        try:
            year = int(node_name.split('.')[0])
            if year in year_nodes:
                year_nodes[year].append(node_name)
        except ValueError: continue

    # Initialize Year 1
    for next_node, prob in tree.get('start', []):
        absolute_probs[next_node] = prob

    # Propagate probabilities Years 2-5
    for year in range(2, 6):
        for node_name in year_nodes[year]:
            absolute_probs[node_name] = 0.0
        
        prev_year_nodes = year_nodes[year - 1]
        for prev_node in prev_year_nodes:
            prev_prob = absolute_probs.get(prev_node, 0)
            if prev_prob == 0: continue
            
            next_states = tree.get(prev_node, [])
            for next_node, conditional_prob in next_states:
                if next_node in absolute_probs:
                    absolute_probs[next_node] += prev_prob * conditional_prob

    # Calculate expected demand
    expected_annual_demands = []
    for year in range(1, 6):
        expected_demand_for_year = 0.0
        if year in year_nodes and year_nodes[year]:
            for node_name in year_nodes[year]:
                prob = absolute_probs.get(node_name, 0)
                demand = demands.get(node_name, 0)
                expected_demand_for_year += prob * demand
            expected_annual_demands.append(int(round(expected_demand_for_year)))
        
    return expected_annual_demands


def _generate_packages_for_one_day(num_packages: int, date: datetime.date) -> list[dict]:
    """
    Generates package details for a single day using the NEW requested logic.
    Logic Flow: DD -> RD -> RP -> DP
    """
    if num_packages <= 0: return []
    package_list = []
    
    # --- Setup: Generate Sizes and Initial Desired Deposit Times (DD) ---
    required_sizes = np.random.choice(SIZES, size=num_packages, p=SIZE_PROBS)
    
    # Step 1: Generate Desired Deposit (DD) based on hourly probabilities
    deposit_hours = np.random.choice(24, size=num_packages, p=DEPOSIT_HOUR_PROBS)
    hourly_deposit_counts = pd.Series(deposit_hours).value_counts().to_dict()
    
    all_desired_deposit_datetimes = []
    for hour, count in hourly_deposit_counts.items():
        arrival_minutes = _generate_intra_hour_arrival_minutes(count)
        for minute in arrival_minutes:
            try:
                # Create the datetime object for the DD
                base_time = datetime.datetime(year=date.year, month=date.month, day=date.day, hour=hour)
                all_desired_deposit_datetimes.append(base_time + datetime.timedelta(minutes=minute))
            except Exception as e:
                print(f"Warning: Could not create datetime for {date} hour {hour}. Skipping package. Error: {e}")
                continue

    random.shuffle(all_desired_deposit_datetimes)
    
    # --- Iterate package by package ---
    for i in range(len(all_desired_deposit_datetimes)):
        
        # 1. Get Desired Deposit Time (DD)
        desired_deposit_dt = all_desired_deposit_datetimes[i]
        
        # 2. Generate Real Deposit Time (RD) = DD + offset
        deposit_offset_hours = random.uniform(DEPOSIT_OFFSET_MIN, DEPOSIT_OFFSET_MAX)
        real_deposit_dt = desired_deposit_dt + datetime.timedelta(hours=deposit_offset_hours)
            
        # 3. Generate Real Pickup Time (RP) based on RD + Matrix
        rd_hour = real_deposit_dt.hour
        
        # Get the conditional probability row P(p|d) using the REAL deposit hour
        conditional_probs = CONDITIONAL_PICKUP_PROBS_MATRIX[rd_hour]
        
        # Sample the pickup hour 'p'
        rp_hour = np.random.choice(24, p=conditional_probs)
        # Sample the pickup minute uniformly within the hour
        rp_minute = np.random.uniform(0, 59.99)
        
        rp_date = real_deposit_dt.date()
        
        # Apply next-day rule if pickup hour is earlier than deposit hour (Table 3 logic)
        if rp_hour < rd_hour: 
            rp_date += datetime.timedelta(days=1)
            
        try:
            base_pickup_time = datetime.datetime(year=rp_date.year, month=rp_date.month, day=rp_date.day, hour=rp_hour)
            real_pickup_dt = base_pickup_time + datetime.timedelta(minutes=rp_minute)
        except Exception as e:
             print(f"Warning: Could not create Real Pickup datetime. Skipping package. Error: {e}")
             continue

        # Edge case check: Ensure RD < RP. 
        # If RD and RP are in the same hour, the randomly generated minutes might cause inversion.
        if real_pickup_dt <= real_deposit_dt:
             # If inversion occurs, force RP to be shortly after RD.
             real_pickup_dt = real_deposit_dt + MINIMUM_SOJOURN

        # 4. Generate Desired Pickup Time (DP) = RD + Fixed Window
        desired_pickup_dt = real_deposit_dt + FIXED_DESIRED_WINDOW


        # Final assertion (should always pass due to step 3 checks)
        assert real_pickup_dt > real_deposit_dt, "Sojourn time constraint failed!"

        # 5. Append the package
        # We use the i-th size for the i-th successful package generation.
        # This is statistically sound as sizes are i.i.d.
        package_list.append({
            'min_size_ft3': required_sizes[i], 
            'desired_deposit_dt': desired_deposit_dt,
            'desired_pickup_dt': desired_pickup_dt, 
            'real_deposit_dt': real_deposit_dt,
            'real_pickup_dt': real_pickup_dt
        })
        
    return package_list


