def generate_five_year_demand_instance(
    simulation_mode: str = 'random', 
    fixed_demand: int = None
) -> pd.DataFrame:
    """
    Develops a locker bank demand simulator (Task 3).
    """
    
    # --- Determine Annual Demand Path ---
    if simulation_mode == 'steady':
        print(f"--- Starting 5-Year STEADY STATE (Weighted Average) Demand Simulation ---")
        annual_demands = _calculate_expected_annual_demands(SCENARIO_TREE, SCENARIO_DEMANDS)
    elif simulation_mode == 'fixed':
        print(f"--- Starting 5-Year FIXED Demand Simulation ---")
        if fixed_demand is None: fixed_demand = 80000
        annual_demands = [fixed_demand] * 5
    else: # 'random' or 'highest'
        print(f"--- Starting 5-Year Dynamic Demand Simulation (Mode: {simulation_mode.upper()}) ---")
        annual_demands = _simulate_annual_demand_path(mode=simulation_mode)
        
    print(f"Annual Demand Targets: {annual_demands}")

    # --- Setup Date Range Template ---
    # We use the Start Year to define the initial 5-year simulation period for demand generation
    start_date = datetime.date(START_YEAR, 1, 1)
    # The simulation ends at the stroke of midnight when the 5th year finishes
    end_date = datetime.date(START_YEAR + 5, 1, 1) - datetime.timedelta(days=1)
    date_range = pd.to_datetime(pd.date_range(start=start_date, end=end_date, freq='D'))
    
    daily_demand_df = pd.DataFrame(date_range, columns=['date'])
    daily_demand_df['year'] = daily_demand_df['date'].dt.year
    # Calculate the 28-day period (1-13), handling day-of-year correctly
    daily_demand_df['period'] = ((daily_demand_df['date'].dt.dayofyear - 1) // 28) + 1
    daily_demand_df['period'] = daily_demand_df['period'].clip(upper=13)
    daily_demand_df['day_of_week'] = daily_demand_df['date'].dt.dayofweek
    
    # --- Simulate Daily Demand (Table 2 logic) ---
    # This section distributes the annual demand down to the daily level based on period and DOW shares/CVs.
    all_years_dfs = []
    for year_idx, total_annual_demand in enumerate(annual_demands):
        year = START_YEAR + year_idx
        year_df_template = daily_demand_df[daily_demand_df['year'] == year].copy()
        
        all_period_dfs = []
        # 1. Simulate Period Demand
        for period_num in range(1, 14):
            period_df = year_df_template[year_df_template['period'] == period_num].copy()
            if len(period_df) == 0: continue

            expected_period_demand = total_annual_demand * PERIOD_DEMAND_SHARE[period_num]
            period_std_dev = expected_period_demand * PERIOD_CV
            simulated_period_demand = int(max(0, round(np.random.normal(expected_period_demand, period_std_dev))))

            # 2. Simulate Daily Demand within Period
            if len(period_df) > 0 and simulated_period_demand > 0:
                period_df['dow_share'] = period_df['day_of_week'].map(DAY_OF_WEEK_SHARE_FROM_PDF)
                total_dow_share_in_period = period_df['dow_share'].sum()
                
                if total_dow_share_in_period > 0:
                    period_df['daily_share_of_period'] = period_df['dow_share'] / total_dow_share_in_period
                    period_df['expected_daily'] = simulated_period_demand * period_df['daily_share_of_period']
                else:
                    # Fallback if shares are somehow zero (should not happen with provided data)
                    period_df['expected_daily'] = simulated_period_demand / len(period_df)
                
                # Apply Daily CV
                daily_std_dev = period_df['expected_daily'] * DAILY_DEMAND_CV
                period_df['simulated_daily'] = np.random.normal(period_df['expected_daily'], daily_std_dev)
                period_df['simulated_daily'] = period_df['simulated_daily'].fillna(0).round().astype(int).clip(lower=0)
                
                # 3. Normalize daily demand to exactly match the simulated period demand
                current_sum = period_df['simulated_daily'].sum()
                if current_sum > 0:
                    scale_factor = simulated_period_demand / current_sum
                    period_df['final_daily_demand'] = (period_df['simulated_daily'] * scale_factor).round().astype(int)
                else:
                    # If all simulated daily demands were 0 but period demand > 0, redistribute based on expectation
                    if period_df['expected_daily'].sum() > 0:
                        weights = period_df['expected_daily'] / period_df['expected_daily'].sum()
                        counts = (weights * simulated_period_demand).round().astype(int)
                        period_df['final_daily_demand'] = counts
                    else:
                         period_df['final_daily_demand'] = 0

                # Handle remainder due to rounding
                remainder = simulated_period_demand - period_df['final_daily_demand'].sum()
                if remainder != 0:
                    # Distribute the remainder randomly across the days in the period
                    indices = np.random.choice(period_df.index, size=abs(int(remainder)), replace=True)
                    adjustment = 1 if remainder > 0 else -1
                    for idx in indices:
                        # Ensure demand doesn't drop below zero if subtracting
                        if period_df.loc[idx, 'final_daily_demand'] + adjustment >= 0:
                            period_df.loc[idx, 'final_daily_demand'] += adjustment

            else:
                 period_df['final_daily_demand'] = 0

            all_period_dfs.append(period_df)
        
        if all_period_dfs:
            year_df_final = pd.concat(all_period_dfs)
            all_years_dfs.append(year_df_final)

    if not all_years_dfs: return pd.DataFrame()
    
    final_demand_schedule = pd.concat(all_years_dfs)
    
    # --- Generate Individual Package Details ---
    all_packages = []
    print("\nGenerating individual package details for each day...")
    # Iterate over the daily demand schedule. The 'date' here is the date for the initial Desired Deposit.
    for _, row in tqdm(final_demand_schedule.iterrows(), total=len(final_demand_schedule), desc="Daily Progress"):
        num_packages_today = row['final_daily_demand']
        if num_packages_today > 0:
            # Call the function with the modified logic
            packages_today = _generate_packages_for_one_day(int(num_packages_today), row['date'].date())
            all_packages.extend(packages_today)
            
    print("\nSimulation complete. Finalizing DataFrame.")
    demand_instance_df = pd.DataFrame(all_packages)
    
    if not demand_instance_df.empty:
        demand_instance_df.insert(0, 'package_id', range(1, len(demand_instance_df) + 1))
    
    return demand_instance_df


